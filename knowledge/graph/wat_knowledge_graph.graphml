<node id="model:pedersen_wax_fraction">
  <data key="d0">equation</data>
  <data key="d1">Pedersen wax-forming fraction of a C7+ pseudo-component from its molar mass and density</data>
  <data key="d2">correlations</data>
  <data key="d3">wax_content</data>
  <data key="d4">secondary_citation</data>
  <data key="d5">medium</data>
  <data key="d6">def wax_frac(M, rho, A=1.074, B=6.584e-4, C=0.1915):
    import numpy as np
    rhoP = 0.3915 + 0.0675*np.log(M)
    x = max((rho - rhoP)/rhoP, 0.0)
    return min(max(1.0 - (A + B*M)*x**C, 0.0), 1.0)</data>
  <data key="d7">{"M": [90, 1000], "rho": [0.7, 1.0]}</data>
</node>
<node id="url:https://github.com/equinor/neqsim/blob/master/src/main/java/neqsim/thermo/characterization/WaxCharacterise.java">
  <data key="d0">source</data>
