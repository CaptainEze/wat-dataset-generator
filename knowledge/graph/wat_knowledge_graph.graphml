<node id="model:benamara2019_gmdh_wdt">
  <data key="d0">equation</data>
  <data key="d1">Benamara 2019 GMDH correlation for WDT from molar mass and pressure</data>
  <data key="d2">correlations</data>
  <data key="d3">WDT</data>
  <data key="d4">full_text</data>
  <data key="d5">low</data>
  <data key="d6">def wdt_gmdh(Mw, P):
    N1 = (311.717497 - 0.846573*Mw - 2.291962*P + 0.019415*P*Mw + 0.004486*Mw**2 + 0.006797*P**2
          - 3.785475e-5*P*Mw**2 - 2.333055e-5*P**2*Mw - 5.316561e-6*Mw**3 - 1.047021e-5*P**3)
    return (-12023.569720 + 116.749816*N1 + 8.223453*Mw - 0.231889*Mw*N1 - 0.305308*N1**2 + 0.119582*Mw**2
            + 0.000855*Mw*N1**2 - 0.000628*Mw**2*N1 + 0.000133*N1**3 + 0.0001*Mw**3)</data>
  <data key="d7">{"Mw": [87.9359, 282.5518], "P": [0.1, 100.3], "WDT_K": [247.9642, 321.1]}</data>
</node>
