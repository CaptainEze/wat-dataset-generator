<node id="model:walther_astm_d341">
  <data key="d0">equation</data>
  <data key="d1">ASTM D341 Walther viscosity-temperature equation (with D341-09 low-viscosity terms)</data>
  <data key="d2">bulk</data>
  <data key="d3">viscosity</data>
  <data key="d4">secondary_citation</data>
  <data key="d5">high</data>
  <data key="d6">import math
Z = 10**(10**(A - B*math.log10(TK)))
z = Z - 0.7
return z - math.exp(-0.7487 - 3.295*z + 0.6119*z**2 - 0.3191*z**3)</data>
  <data key="d7">{"v": [0.21, 10000000.0]}</data>
</node>
