<edge source="model:mu_od_beal_standing" target="property:viscosity" id="0">
  <data key="d17">predicts</data>
</edge>
<edge source="url:Three secondary sources agree on coefficients. Note: petpropy and IntechOpen write T-260 or (T-460)+200 with T in Rankine, same thing." target="model:mu_od_beal_standing" id="0">
  <data key="d17">provides_equation</data>
</edge>
<edge source="model:mu_od_beggs_robinson_1975" target="property:viscosity" id="0">
  <data key="d17">predicts</data>
</edge>
<edge source="url:Three code sources agree; the exp form reproduces the 10^ form within 0.02 %. PetroWiki and IHS documentation state it overpredicts below about 75 to 150 F, consistent with our +0.19 log10 bias at 104 F." target="model:mu_od_beggs_robinson_1975" id="0">
  <data key="d17">provides_equation</data>
</edge>
<edge source="model:mu_od_glaso_1980" target="property:viscosity" id="0">
  <data key="d17">predicts</data>
</edge>
<edge source="url:Four sources agree. Among the best performers on our pools at 40 C." target="model:mu_od_glaso_1980" id="0">
  <data key="d17">provides_equation</data>
</edge>
<edge source="model:mu_od_ng_egbogah_1983" target="property:viscosity" id="0">
  <data key="d17">predicts</data>
</edge>
<edge source="url:Four code sources agree (one notebook rounds 1.8653 to 1.863). The PAPER ALSO HAS A POUR-POINT VERSION (IHS Harmony documentation: pour point -50 to 15 C, API 5 to 58) that we could not read: equation is an image. Gap." target="model:mu_od_ng_egbogah_1983" id="0">
  <data key="d17">provides_equation</data>
</edge>
<edge source="model:mu_od_kartoatmodjo_schmidt_1994" target="property:viscosity" id="0">
  <data key="d17">predicts</data>
</edge>
