<node id="fact:struchkov_coolrate_rheo">
  <data key="d0">fact</data>
  <data key="d1">Rheometric WAT = -0.739*ln(cooling rate in C/s) + 31.141 C (R2 0.9935) for 30 wt% wax in kerosene: about 36.2 C at 0.001 C/s and 34.8 C at 0.007 C/s</data>
  <data key="d2">effects</data>
  <data key="d11">decreases</data>
  <data key="d12">-0.739</data>
  <data key="d13">-0.739</data>
  <data key="d14">C per ln(C/s)</data>
  <data key="d5">medium</data>
</node>
<node id="fact:struchkov_impurities">
  <data key="d0">fact</data>
  <data key="d1">Adding 0.25 to 2 g/L solids raised rheometric WAT from 33.1 C to 34.1 to 36.5 C (+1.0 to +3.4 C; calcite largest, kaolinite smallest)</data>
