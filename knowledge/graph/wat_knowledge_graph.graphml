<node id="model:semwal_cloud_point_blend">
  <data key="d0">equation</data>
  <data key="d1">Cloud point blending rule (power law, exponent 13.45)</data>
  <data key="d2">correlations</data>
  <data key="d3">cloud_point</data>
  <data key="d4">secondary_citation</data>
  <data key="d5">medium</data>
  <data key="d6">def cp_blend(V, CP):
    import numpy as np
    R = (np.asarray(CP, float) + 273.15)*1.8
    return (np.sum(np.asarray(V, float)*R**13.45))**(1/13.45)/1.8 - 273.15</data>
  <data key="d7">{"note": "diesel fuel blends"}</data>
</node>
