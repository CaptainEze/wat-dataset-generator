  <data key="d0">source</data>
  <data key="d1">Benamara, C., Gharbi, K., Nait Amar, M., Hamada, B. (2020). Prediction of Wax Appearance Temperature Using Artificial Intelligent Techniques. Arabian Journal fo</data>
  <data key="d8">10.1007/s13369-019-04290-y</data>
  <data key="d9">https://www.academia.edu/82702550/Prediction_of_Wax_Appearance_Temperature_Using_Artificial_Intelligent_Techniques</data>
</node>
