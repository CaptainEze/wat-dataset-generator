<node id="model:benamara2020_gep_wat">
  <data key="d0">equation</data>
  <data key="d1">Benamara 2020 GEP explicit WAT model (density, wax, pour point, freezing point)</data>
  <data key="d2">correlations</data>
  <data key="d3">WAT</data>
  <data key="d4">full_text</data>
  <data key="d5">low</data>
  <data key="d6">def wat_gep_literal(d, Wt, PP, FP):
    import numpy as np
    r5 = lambda x: np.sign(x)*abs(x)**0.2
    T1 = 11.14*Wt**6*(Wt/d - 6.329)/(2.815*Wt + 1.407*FP)
    A = r5(d - PP + 22.1317*Wt - 14.4856*Wt**2 + (PP - FP)*Wt)
    B = np.tanh(7.0155*Wt**3 + FP - np.exp(Wt) - np.tanh(Wt))
    C = -884.7*np.tanh(Wt**2 - np.exp(d - Wt)) + 4053
    D = -0.09917*np.exp(np.exp(-Wt)/np.log(Wt)) + 869.1*np.exp(-0.249*np.exp(Wt)/d - 2.482*np.exp(Wt))
    E = -(0.0482*(d + FP) - 1.146)/(230.6*Wt**2 - 1371) - 1</data>
  <data key="d7">{"d": [0.7144, 0.8432], "Wt": [0.61, 6.39], "PP": [237.15, 284.15], "FP": [235.55, 286.35], "WAT_K": [267.85, 299.05]}</data>
</node>
