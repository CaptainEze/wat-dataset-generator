<node id="model:api_mpms_11_1_2004_ctl_crude">
  <data key="d0">equation</data>
  <data key="d1">API MPMS 11.1-2004 temperature correction (CTL), crude oil group</data>
  <data key="d2">bulk</data>
  <data key="d3">density</data>
  <data key="d4">secondary_citation</data>
  <data key="d5">high</data>
  <data key="d6">import math
rho60 = 999.016*141.5/(API+131.5)
K0 = 341.0957
A = (0.01374979547/2.0)*(K0/rho60**2)
B = 2.0
rs = rho60*(1 + (math.exp(A*(1+0.8*A)) - 1)/(1 + A*(1+1.6*A)*B))
a60 = K0/rs**2
tc = (T-32)/1.8; tau = tc/630.0
c = [-0.148759,-0.267408,1.080760,1.269056,-4.089591,-1.871251,7.438081,-3.536296]
d = c[-1]
for ci in c[-2::-1]: d = ci + d*tau
t68 = (tc - d*tau)*1.8 + 32
dT = t68 - 60.0068749
return math.exp(-a60*dT*(1 + 0.8*a60*(dT + 0.01374979547)))</data>
  <data key="d7">{"API": [-10, 100], "T": [-58, 302]}</data>
</node>
<node id="property:temperature">
  <data key="d0">property</data>
  <data key="d1">temperature</data>
</node>
